---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_NAME, CTA } from '../../lib/site';
---

<BaseLayout
  title={`Message sent | ${SITE_NAME}`}
  description="Your message has been sent to Our Healing Voices."
  path="/reach-out/thank-you/"
  noindex
>
  <section class="sent section-dark">
    <div class="shell shell-narrow">
      <p class="eyebrow">Reach Out</p>
      <h1>Your message is on its way</h1>
      <p class="lede">
        Thank you for writing. It has been received, and a reply will come to the address you gave.
      </p>
      <div class="btn-row">
        <a class="btn" href="/conversations/">{CTA.explore}</a>
        <a class="btn btn-secondary" href="/">Back to the home page</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sent {
    background: var(--surface-deep);
    color: var(--ink-inverse);
    padding-block: var(--space-2xl);
  }

  .sent h1 {
    margin-bottom: var(--space-s);
  }
</style>
