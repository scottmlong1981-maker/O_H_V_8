---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, CTA } from '../lib/site';
---

<BaseLayout
  title={`Page not found | ${SITE_NAME}`}
  description="This page could not be found. Every published conversation is still here."
  path="/404/"
  noindex
>
  <section class="notfound section-dark">
    <div class="shell shell-narrow">
      <p class="eyebrow">404</p>
      <h1>This page isn't here</h1>
      <p class="lede">
        The conversations are, though. Nothing published has gone anywhere.
      </p>
      <div class="btn-row">
        <a class="btn" href="/conversations/">{CTA.explore}</a>
        <a class="btn btn-secondary" href="/">Back to the home page</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    background: var(--surface-deep);
    color: var(--ink-inverse);
    padding-block: var(--space-2xl);
  }

  .notfound h1 {
    margin-bottom: var(--space-s);
  }
</style>
