---
interface Props {
  videoId: string;
  /** Used as the accessible name of the player. */
  title: string;
}

const { videoId, title } = Astro.props;
// nocookie host, no autoplay, no related videos from other channels.
const src = `https://www.youtube-nocookie.com/embed/${videoId}?rel=0`;
---

<div class="embed">
  <iframe
    src={src}
    title={`${title} — video player`}
    loading="lazy"
    width="560"
    height="315"
    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen></iframe>
</div>

<style>
  .embed {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    background: var(--surface-deepest);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
