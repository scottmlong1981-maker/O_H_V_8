---
import ConversationImage from './ConversationImage.astro';
import PlayOverlay from './PlayOverlay.astro';
import { formatDate, cardDescription, youtubeThumbnail, type Conversation } from '../lib/content';

interface Props {
  conversation: Conversation;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}

const { conversation: c, headingLevel = 'h3', eager = false } = Astro.props;
const Heading = headingLevel;
const href = `/conversations/${c.slug}/`;

// Every card that shows a title and description also shows the episode's own
// YouTube thumbnail, in its natural 16:9 ratio, whenever a video is on record.
const thumbnail = youtubeThumbnail(c);
const hasImage = Boolean(c.image || thumbnail);
// The play mark appears only over a real, linked YouTube video.
const isVideo = Boolean(thumbnail && c.platforms.youtubeVideoId);
const summary = cardDescription(c);
---

<article class="card">
  <a
    class:list={['card__media', !hasImage && 'card__media--brand']}
    href={href}
    tabindex="-1"
    aria-hidden="true"
  >
    <ConversationImage src={c.image} thumbnail={thumbnail} alt="" loading={eager ? 'eager' : 'lazy'} />
    {isVideo && <PlayOverlay />}
  </a>

  <div class="card__body">
    <p class="card__meta">
      <time datetime={c.publicationDate}>{formatDate(c.publicationDate)}</time>
      {c.guest.name && <><span aria-hidden="true"> / </span>{c.guest.name}</>}
    </p>

    <Heading class="card__title">
      <a href={href}>{c.title}</a>
    </Heading>

    {summary && <p class="card__text">{summary}</p>}

    {
      c.themes.length > 0 && (
        <ul class="tag-list card__themes">
          {c.themes.map((theme) => (
            <li><span class="tag tag-theme">{theme}</span></li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--surface-quiet);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    height: 100%;
  }

  /* The thumbnail's natural ratio — the way a video first appears on YouTube. */
  .card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    background: var(--surface-deep);
  }

  /* No video on record: a quiet brand band rather than a picture-sized void. */
  .card__media--brand {
    aspect-ratio: 5 / 1;
  }

  .card__body {
    padding: var(--space-m);
    display: grid;
    align-content: start;
    gap: var(--space-xs);
  }

  .card__meta {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-quiet);
    margin: 0;
  }

  .card__title {
    font-size: var(--step-2);
    margin: 0;
  }

  .card__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .card__title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .card__text {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--step-0);
  }

  .card__themes {
    margin-top: var(--space-2xs);
  }
</style>
